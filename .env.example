# Tripwire — Firebase web config.
# Copy this file to `.env` and fill in the values from:
#   Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration
#
# These are the standard, public Firebase web config values. They are NOT secrets
# (Firebase security comes from App Check + security rules), but `.env` is still
# gitignored so each developer points at their own project.
#
# The Gemini API key never appears here or anywhere in this codebase:
# Firebase AI Logic keeps it server-side behind its proxy.

WXT_FIREBASE_API_KEY=
WXT_FIREBASE_AUTH_DOMAIN=
WXT_FIREBASE_PROJECT_ID=
WXT_FIREBASE_STORAGE_BUCKET=
WXT_FIREBASE_MESSAGING_SENDER_ID=
WXT_FIREBASE_APP_ID=

# App Check debug token (a UUID you generate, e.g. with `node -e "console.log(crypto.randomUUID())"`).
# Register it in: Firebase console → Security → App Check → Apps → your web app → Manage debug tokens.
# Keep it private. Never commit it. See README → "App Check from a chrome-extension:// origin".
WXT_APPCHECK_DEBUG_TOKEN=

# Where the family dashboard is hosted (shown to the user during pairing).
# Example: https://your-project-id.web.app
WXT_DASHBOARD_URL=

# Optional. Where the practice scam pages are served. Defaults to <dashboard>/demo/ or http://localhost:4174/ (npm run demo).
WXT_DEMO_URL=

# Optional. reCAPTCHA Enterprise site key (a public value) for App Check on the hosted family page.
WXT_RECAPTCHA_SITE_KEY=
