rules_version = '2';

// Tripwire: Family Guardian security rules.
//
// Principles
//   1. A protected person's device is identified by its (anonymous) auth uid.
//   2. A guardian can only link to a device by presenting a live pairing code,
//      and each code can be claimed by exactly one guardian.
//   3. Alerts have a fixed, tiny shape with no free text at all: four enums, a
//      server timestamp, and a summary that must be the one fixed sentence for
//      that kind of scam. Page or email content cannot be stored, even by a
//      modified client.
//   4. Everything not listed is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isDevice(deviceId) {
      return signedIn() && request.auth.uid == deviceId;
    }

    // A link counts only once the person has tapped "Yes, allow" on their own computer, so a
    // guessed or overheard pairing code is not enough to see their alerts.
    function isGuardianOf(deviceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/devices/$(deviceId)/guardians/$(request.auth.uid))
        && get(/databases/$(database)/documents/devices/$(deviceId)/guardians/$(request.auth.uid)).data.get('approved', false) == true;
    }

    function validNewCode(code) {
      let d = request.resource.data;
      return code.matches('^[0-9]{8}$')
        && d.keys().hasOnly(['deviceId', 'createdAt', 'expiresAt'])
        && d.deviceId == request.auth.uid
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(6, 'm');
    }

    // The one sentence an alert may carry for each kind of scam. Mirrors ALERT_SUMMARY
    // in src/ui/copy (a unit test keeps the two in step). Because the summary must be
    // exactly this sentence, an alert cannot carry free text of any kind.
    // The clock may stay as it is, or move to now if the last alert was over 15 seconds ago.
    // Once set it can never be removed or set to any other time.
    function alertClockOk(before, after) {
      return ('lastAlertAt' in after || !('lastAlertAt' in before))
        && (!('lastAlertAt' in after)
          || ('lastAlertAt' in before && after.lastAlertAt == before.lastAlertAt)
          || (after.lastAlertAt == request.time
            && (!('lastAlertAt' in before) || request.time > before.lastAlertAt + duration.value(15, 's'))));
    }

    function summaryFor(scamType) {
      return {
        'none': 'Tripwire saw several warning signs of a scam.',
        'tech_support': 'A page claimed the computer had a problem and pushed for a call or remote access.',
        'gift_card': 'A message asked for payment in gift cards.',
        'bank_impersonation': 'A message posing as a bank asked for account or card details.',
        'government_impersonation': 'A message posing as a government office demanded money or personal details.',
        'delivery': 'A delivery notice asked for a fee or card details to release a package.',
        'shopping_impersonation': 'A message posing as a store asked for account or payment details.',
        'investment_crypto': 'An offer promised returns and asked for money by crypto or wire.',
        'prize_lottery': 'A prize notice asked for a fee or personal details to collect winnings.',
        'romance': 'Someone asked for money to be sent in a way that cannot be undone.',
        'payment_request': 'A page asked for an unexpected payment or card number.',
        'phishing_login': 'A page that looked like a sign-in screen asked for a password.',
        'other': 'Tripwire saw several warning signs of a scam.'
      }[scamType];
    }

    // ── Pairing codes ────────────────────────────────────────────────────
    // Readable one at a time by anyone signed in who already knows the code.
    // Never listable, so codes cannot be enumerated with a query.
    match /pairingCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validNewCode(code);
      // Two kinds of update, nothing else:
      //  - the device reusing a code number after the previous one expired;
      //  - ONE guardian claiming a live code. The claim is a field only that guardian
      //    can set, only once, so a code cannot be used twice even if it leaks.
      allow update: if signedIn() && (
        (resource.data.expiresAt < request.time && validNewCode(code))
        || (
          !('usedBy' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
          && request.resource.data.usedBy == request.auth.uid
          && request.auth.uid != resource.data.deviceId
          && resource.data.expiresAt > request.time
          // The claim and the guardian link are one write: a guessed code cannot just be used up.
          && existsAfter(/databases/$(database)/documents/devices/$(resource.data.deviceId)/guardians/$(request.auth.uid))
        )
      );
      allow delete: if signedIn() && resource.data.deviceId == request.auth.uid;
    }

    // ── Devices ──────────────────────────────────────────────────────────
    match /devices/{deviceId} {
      allow get: if isDevice(deviceId) || isGuardianOf(deviceId);
      allow list: if false;
      // lastAlertAt is the device's alert clock: each alert must move it to now, and it can move
      // at most once every 15 seconds, so a broken or looping client cannot flood the family feed.
      allow create: if isDevice(deviceId)
        && request.resource.data.keys().hasOnly(['createdAt', 'lastAlertAt'])
        && (!('lastAlertAt' in request.resource.data) || request.resource.data.lastAlertAt == request.time);
      allow update: if isDevice(deviceId)
        && request.resource.data.keys().hasOnly(['createdAt', 'lastAlertAt'])
        && alertClockOk(resource.data, request.resource.data);
      allow delete: if false;

      // A guardian link is created by the guardian, proving knowledge of a
      // live pairing code that belongs to this device.
      match /guardians/{guardianId} {
        allow get: if isDevice(deviceId) || (signedIn() && request.auth.uid == guardianId);
        allow list: if isDevice(deviceId);
        allow create: if signedIn()
          && request.auth.uid == guardianId
          && request.auth.uid != deviceId
          && request.resource.data.keys().hasOnly(['code', 'pairedAt', 'name'])
          // A first name only: letters, spaces, hyphens, apostrophes and full stops. No digits, so
          // "Microsoft Support 1-800..." cannot appear in the "just typed your code" prompt.
          && (!('name' in request.resource.data) || (request.resource.data.name is string
              && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
              && request.resource.data.name.matches("^\\p{L}[\\p{L} .'-]{0,39}$")))
          && request.resource.data.code is string
          && request.resource.data.code.matches('^[0-9]{8}$')
          && request.resource.data.pairedAt == request.time
          && exists(/databases/$(database)/documents/pairingCodes/$(request.resource.data.code))
          && get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.code)).data.deviceId == deviceId
          && get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.code)).data.expiresAt > request.time
          // ...and this guardian must be the one who claimed the code, in this same write.
          && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.code)).data.usedBy == request.auth.uid;
        // Only the device can approve a link, and approving is the only change allowed.
        allow update: if isDevice(deviceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
          && request.resource.data.approved == true;
        // Either side can end the link.
        allow delete: if isDevice(deviceId) || (signedIn() && request.auth.uid == guardianId);
      }

      // Alerts: written only by the device, read by the device and its guardians.
      match /alerts/{alertId} {
        allow read: if isDevice(deviceId) || isGuardianOf(deviceId);
        allow create: if isDevice(deviceId)
          && request.resource.data.keys().hasOnly(['createdAt', 'scamType', 'summary', 'action', 'outcome'])
          && request.resource.data.keys().hasAll(['createdAt', 'scamType', 'summary', 'action', 'outcome'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.scamType in [
               'none', 'tech_support', 'gift_card', 'bank_impersonation', 'government_impersonation',
               'delivery', 'shopping_impersonation', 'investment_crypto', 'prize_lottery', 'romance',
               'payment_request', 'phishing_login', 'other'
             ]
          && request.resource.data.summary == summaryFor(request.resource.data.scamType)
          && request.resource.data.action in [
               'passive', 'card_entry', 'remote_download', 'phone_call', 'gift_card', 'crypto_wire', 'live_call'
             ]
          && request.resource.data.outcome in ['stopped', 'continued']
          // Written together with the device's alert clock (see above).
          && getAfter(/databases/$(database)/documents/devices/$(deviceId)).data.get('lastAlertAt', null) == request.time;
        // Alerts are an immutable record.
        allow update, delete: if false;
      }
    }

    // ── A guardian's own list of the people they look out for ────────────
    match /guardians/{guardianId}/people/{deviceId} {
      allow read, delete: if signedIn() && request.auth.uid == guardianId;
      allow create, update: if signedIn()
        && request.auth.uid == guardianId
        && request.resource.data.keys().hasOnly(['nickname', 'addedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 40;
    }
  }
}
